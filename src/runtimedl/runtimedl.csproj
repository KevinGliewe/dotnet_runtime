<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>

    <VersionPrefix>1.0.5</VersionPrefix>

    <Authors>Kevin Gliewe</Authors>
    <Company>Gliewe.Net</Company>
    <Description>Self-contained tool to download a dotnet runtime</Description>
    <RepositoryUrl>https://github.com/KevinGliewe/dotnet_runtime</RepositoryUrl>
    <PackageProjectUrl>https://github.com/KevinGliewe/dotnet_runtime/tree/runtimedl-tool</PackageProjectUrl>
    <PackageLicenseUrl>https://github.com/KevinGliewe/dotnet_runtime/blob/master/LICENSE</PackageLicenseUrl>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- Self-contained single-file publishing -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <StripSymbols>true</StripSymbols>

    <!-- Trimming configuration -->
    <TrimMode>link</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine.DragonFruit" Version="0.3.0-alpha.21216.1" />
    <PackageReference Include="ShellProgressBar" Version="5.1.0" />
    <PackageReference Include="SemanticVersioning" Version="2.0.0" />
    <PackageReference Include="SharpZipLib" Version="1.3.3" />
  </ItemGroup>

</Project>
