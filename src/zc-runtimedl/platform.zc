// platform.zc — Platform/architecture detection and RID mapping

import "./extern/zenc-std/string.zc"

raw {
#include <string.h>
#include <stdio.h>
#include <sys/utsname.h>

typedef struct {
    char platform[32];
    char arch[32];
} DetectedSystem;

static DetectedSystem detect_system(void) {
    DetectedSystem sys = {{0}, {0}};
    struct utsname un;
    if (uname(&un) == 0) {
        if (strstr(un.sysname, "Linux")) strcpy(sys.platform, "linux");
        else if (strstr(un.sysname, "Darwin")) strcpy(sys.platform, "macos");
        else if (strstr(un.sysname, "MINGW") || strstr(un.sysname, "CYGWIN") ||
                 strstr(un.sysname, "Windows") || strstr(un.sysname, "MSYS"))
            strcpy(sys.platform, "windows");
        else if (strstr(un.sysname, "FreeBSD")) strcpy(sys.platform, "linux");
        else strcpy(sys.platform, "linux");

        if (strstr(un.machine, "x86_64") || strstr(un.machine, "amd64"))
            strcpy(sys.arch, "x64");
        else if (strstr(un.machine, "aarch64") || strstr(un.machine, "arm64"))
            strcpy(sys.arch, "arm64");
        else if (strstr(un.machine, "armv7") || strstr(un.machine, "armhf"))
            strcpy(sys.arch, "arm32");
        else if (strstr(un.machine, "i686") || strstr(un.machine, "i386"))
            strcpy(sys.arch, "x86");
        else
            strcpy(sys.arch, "x64");
    } else {
        strcpy(sys.platform, "linux");
        strcpy(sys.arch, "x64");
    }
    return sys;
}
}

fn platform_to_rid(platform: char*) -> char* {
    let s = String::new(platform)
    if (s.eq_str("windows")) { return "win" }
    if (s.eq_str("macos")) { return "osx" }
    if (s.eq_str("linux")) { return "linux" }
    return platform
}

fn arch_to_rid(arch: char*) -> char* {
    let s = String::new(arch)
    if (s.eq_str("arm32")) { return "arm" }
    return arch
}

fn build_rid(platform: char*, arch: char*, out: char*, out_sz: int) {
    let arch_str = String::new(arch)
    let is_alpine = arch_str.contains_str("-alpine")
    if (is_alpine) {
        let dash = arch_str.find_str("-alpine")
        let idx = dash.unwrap()
        let base = arch_str.substring(0, idx)
        let base_rid = arch_to_rid(base.c_str())
        raw { snprintf(out, out_sz, "linux-musl-%s", base_rid); return; }
    }
    let plat_rid = platform_to_rid(platform)
    let arch_rid = arch_to_rid(arch)
    raw { snprintf(out, out_sz, "%s-%s", plat_rid, arch_rid); }
}

fn type_to_json_key(runtime_type: char*) -> char* {
    let s = String::new(runtime_type)
    if (s.eq_str("sdk")) { return "sdk" }
    if (s.eq_str("runtime")) { return "runtime" }
    if (s.eq_str("runtime-aspnetcore")) { return "aspnetcore-runtime" }
    if (s.eq_str("runtime-desktop")) { return "windowsdesktop" }
    return "runtime"
}

fn type_to_file_prefix(runtime_type: char*) -> char* {
    let s = String::new(runtime_type)
    if (s.eq_str("sdk")) { return "dotnet-sdk-" }
    if (s.eq_str("runtime")) { return "dotnet-runtime-" }
    if (s.eq_str("runtime-aspnetcore")) { return "aspnetcore-runtime-" }
    if (s.eq_str("runtime-desktop")) { return "windowsdesktop-runtime-" }
    return "dotnet-runtime-"
}
