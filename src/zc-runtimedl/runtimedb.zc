// runtimedb.zc — Query Microsoft's .NET release metadata using Zen-C JSON

import "./extern/zenc-std/json.zc"
import "./extern/zenc-std/io.zc"
import "./semver.zc"
import "./platform.zc"
import "./http.zc"

raw {
#define RELEASES_INDEX_URL "https://dotnetcli.blob.core.windows.net/dotnet/release-metadata/releases-index.json"

typedef struct {
    char url[MAX_URL];
    char checksum[256];
    char version[64];
} RuntimeEntry;

int find_best_entry(char* runtime_type, char* platform, char* arch,
                    char* version_pattern, int include_prerelease,
                    RuntimeEntry* result);
}

fn find_best_entry(runtime_type: char*, platform: char*, arch: char*,
                   version_pattern: char*, include_prerelease: int,
                   result: RuntimeEntry*) -> int {

    let json_key = type_to_json_key(runtime_type)
    let file_prefix_str = String::new(type_to_file_prefix(runtime_type))

    let platform_str = String::new(platform)
    let ext_str = String::new(".tar.gz")
    if (platform_str.eq_str("windows")) {
        ext_str = String::new(".zip")
    }

    raw {
        char rid[64];
        build_rid(platform, arch, rid, sizeof(rid));
        SemVer best_ver = {0};
        int found = 0;
        size_t fetch_len;
        char *index_json = fetch_url(RELEASES_INDEX_URL, &fetch_len);
    }

    if (index_json == NULL) {
        println "Error: Failed to fetch releases index"
        return -1
    }

    let index_result = JsonValue::parse(index_json)
    raw { free(index_json); }
    if (index_result.is_err()) {
        println "Error: Failed to parse releases index JSON"
        return -1
    }
    let index: JsonValue* = index_result.unwrap()

    let ri_opt = (*index).get_array("releases-index")
    if (ri_opt.is_none()) {
        return -1
    }
    let ri: JsonValue* = ri_opt.unwrap()
    let ri_len = (*ri).len()

    for (let i: usize = 0; i < ri_len; i = i + 1) {
        let channel_opt = (*ri).at(i)
        if (channel_opt.is_none()) { continue }
        let channel: JsonValue* = channel_opt.unwrap()

        let rel_url_opt = (*channel).get_string("releases.json")
        if (rel_url_opt.is_none()) { continue }
        let rel_url: char* = rel_url_opt.unwrap()

        raw {
            char *chan_json = fetch_url(rel_url, &fetch_len);
            if (!chan_json) continue;
        }

        let chan_result = JsonValue::parse(chan_json)
        raw { free(chan_json); }
        if (chan_result.is_err()) { continue }
        let chan: JsonValue* = chan_result.unwrap()

        let releases_opt = (*chan).get_array("releases")
        if (releases_opt.is_none()) { continue }
        let releases: JsonValue* = releases_opt.unwrap()
        let releases_len = (*releases).len()

        for (let j: usize = 0; j < releases_len; j = j + 1) {
            let release_opt = (*releases).at(j)
            if (release_opt.is_none()) { continue }
            let release: JsonValue* = release_opt.unwrap()

            let component_opt = (*release).get(json_key)
            if (component_opt.is_none()) { continue }
            let component: JsonValue* = component_opt.unwrap()

            let ver_str_opt = (*component).get_string("version")
            if (ver_str_opt.is_none()) { continue }
            let ver_str: char* = ver_str_opt.unwrap()

            let ver = parse_semver(ver_str)
            if (semver_satisfies(&ver, version_pattern, include_prerelease) == 0) {
                continue
            }

            let files_opt = (*component).get_array("files")
            if (files_opt.is_none()) { continue }
            let files: JsonValue* = files_opt.unwrap()
            let files_len = (*files).len()

            for (let k: usize = 0; k < files_len; k = k + 1) {
                let file_opt = (*files).at(k)
                if (file_opt.is_none()) { continue }
                let file: JsonValue* = file_opt.unwrap()

                let file_rid_opt = (*file).get_string("rid")
                if (file_rid_opt.is_none()) { continue }
                let file_rid: char* = file_rid_opt.unwrap()

                let file_rid_s = String::new(file_rid)
                let rid_s = String::new(rid)
                if (!file_rid_s.eq(&rid_s)) { continue }

                let fname_opt = (*file).get_string("name")
                if (fname_opt.is_none()) { continue }
                let fname: char* = fname_opt.unwrap()

                let fname_s = String::new(fname)
                if (!fname_s.starts_with(file_prefix_str.c_str())) { continue }
                if (!fname_s.ends_with(ext_str.c_str())) { continue }

                let url_val_opt = (*file).get_string("url")
                if (url_val_opt.is_none()) { continue }
                let url_val: char* = url_val_opt.unwrap()

                let hash_val: char* = NULL
                let hash_val_opt = (*file).get_string("hash")
                if (!hash_val_opt.is_none()) {
                    hash_val = hash_val_opt.unwrap()
                }

                raw {
                    if (!found || semver_cmp(&ver, &best_ver) > 0) {
                        strncpy(result->url, url_val, sizeof(result->url) - 1);
                        if (hash_val)
                            strncpy(result->checksum, hash_val,
                                    sizeof(result->checksum) - 1);
                        else
                            result->checksum[0] = 0;
                        strncpy(result->version, ver_str,
                                sizeof(result->version) - 1);
                        best_ver = ver;
                        found = 1;
                    }
                }
            }
        }
    }

    if (found) {
        return 0
    }
    return -1
}
