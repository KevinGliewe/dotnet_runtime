// runtimedl - .NET Runtime Downloader
// A cross-OS Actually Portable Executable (APE) built with Zen-C + cosmocc
//
// Downloads and extracts .NET runtimes from Microsoft's official releases.
// Single binary runs on Linux, macOS, Windows, FreeBSD, OpenBSD, NetBSD.

raw {
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <getopt.h>
#include <sys/stat.h>
#include <sys/utsname.h>
#include <errno.h>
#include <strings.h>
#include "third_party/zlib/zlib.h"
#include "cJSON.h"

#include <mbedtls/net_sockets.h>
#include <mbedtls/ssl.h>
#include <mbedtls/ssl_ciphersuites.h>
#include <mbedtls/entropy.h>
#include <mbedtls/ctr_drbg.h>
#include <mbedtls/sha512.h>
#include <mbedtls/error.h>

// Custom entropy source for cosmopolitan libc
// Cosmopolitan provides getrandom() but mbedTLS's entropy_poll.c
// doesn't detect it (no __GLIBC__ defined).
#include <sys/random.h>
static int cosmo_entropy_func(void *data, unsigned char *output, size_t len) {
    (void)data;
    ssize_t ret = getrandom(output, len, 0);
    if (ret < 0 || (size_t)ret != len) return -1;
    return 0;
}

#define VERSION "1.0.0"
#define RELEASES_INDEX_URL "https://dotnetcli.blob.core.windows.net/dotnet/release-metadata/releases-index.json"
#define MAX_URL 2048
#define MAX_PATH_LEN 4096

// ============================================================================
// URL parsing
// ============================================================================

typedef struct {
    char host[256];
    char port[8];
    char path[MAX_URL];
    int is_https;
} ParsedURL;

static int parse_url(const char* url, ParsedURL* out) {
    memset(out, 0, sizeof(*out));
    const char* p = url;
    if (strncmp(p, "https://", 8) == 0) {
        out->is_https = 1; p += 8; strcpy(out->port, "443");
    } else if (strncmp(p, "http://", 7) == 0) {
        out->is_https = 0; p += 7; strcpy(out->port, "80");
    } else return -1;

    const char* slash = strchr(p, '/');
    const char* colon = strchr(p, ':');

    if (colon && (!slash || colon < slash)) {
        size_t host_len = colon - p;
        if (host_len >= sizeof(out->host)) host_len = sizeof(out->host) - 1;
        memcpy(out->host, p, host_len);
        out->host[host_len] = 0;
        colon++;
        const char* port_end = slash ? slash : p + strlen(p);
        size_t port_len = port_end - colon;
        if (port_len >= sizeof(out->port)) port_len = sizeof(out->port) - 1;
        memcpy(out->port, colon, port_len);
        out->port[port_len] = 0;
    } else {
        size_t host_len = slash ? (size_t)(slash - p) : strlen(p);
        if (host_len >= sizeof(out->host)) host_len = sizeof(out->host) - 1;
        memcpy(out->host, p, host_len);
        out->host[host_len] = 0;
    }

    if (slash) {
        strncpy(out->path, slash, sizeof(out->path) - 1);
    } else {
        strcpy(out->path, "/");
    }
    return 0;
}

// ============================================================================
// HTTPS client via mbedTLS
// ============================================================================

typedef struct {
    mbedtls_net_context net;
    mbedtls_ssl_context ssl;
    mbedtls_ssl_config conf;
    mbedtls_entropy_context entropy;
    mbedtls_ctr_drbg_context ctr_drbg;
    int is_https;
} TLSConn;

static int tls_conn_init(TLSConn* c) {
    memset(c, 0, sizeof(*c));
    mbedtls_net_init(&c->net);
    mbedtls_ssl_init(&c->ssl);
    mbedtls_ssl_config_init(&c->conf);
    mbedtls_entropy_init(&c->entropy);
    mbedtls_ctr_drbg_init(&c->ctr_drbg);

    int ret = mbedtls_ctr_drbg_seed(&c->ctr_drbg, cosmo_entropy_func,
                                     NULL, NULL, 0);
    if (ret != 0) return ret;

    ret = mbedtls_ssl_config_defaults(&c->conf, MBEDTLS_SSL_IS_CLIENT,
            MBEDTLS_SSL_TRANSPORT_STREAM, MBEDTLS_SSL_PRESET_DEFAULT);
    if (ret != 0) return ret;

    // Skip certificate verification — integrity ensured via SHA-512 hash check
    mbedtls_ssl_conf_authmode(&c->conf, MBEDTLS_SSL_VERIFY_NONE);
    mbedtls_ssl_conf_rng(&c->conf, mbedtls_ctr_drbg_random, &c->ctr_drbg);

    // Force TLS 1.2 — TLS 1.3 requires PSA crypto which has entropy
    // issues with cosmopolitan libc
    mbedtls_ssl_conf_max_tls_version(&c->conf, MBEDTLS_SSL_VERSION_TLS1_2);
    mbedtls_ssl_conf_min_tls_version(&c->conf, MBEDTLS_SSL_VERSION_TLS1_2);

    ret = mbedtls_ssl_setup(&c->ssl, &c->conf);
    return ret;
}

static void tls_conn_free(TLSConn* c) {
    mbedtls_ssl_close_notify(&c->ssl);
    mbedtls_net_free(&c->net);
    mbedtls_ssl_free(&c->ssl);
    mbedtls_ssl_config_free(&c->conf);
    mbedtls_ctr_drbg_free(&c->ctr_drbg);
    mbedtls_entropy_free(&c->entropy);
}

// Parse proxy URL: http://user:pass@host:port
typedef struct {
    char host[256];
    char port[8];
    char userinfo[4096]; // user:pass for Proxy-Authorization
    int valid;
} ProxyInfo;

static void parse_proxy_env(ProxyInfo* p) {
    memset(p, 0, sizeof(*p));
    const char* proxy = getenv("HTTPS_PROXY");
    if (!proxy) proxy = getenv("https_proxy");
    if (!proxy) proxy = getenv("HTTP_PROXY");
    if (!proxy) proxy = getenv("http_proxy");
    if (!proxy) return;

    const char* s = proxy;
    if (strncmp(s, "http://", 7) == 0) s += 7;
    else if (strncmp(s, "https://", 8) == 0) s += 8;

    // Check for user:pass@
    const char* at = strchr(s, '@');
    const char* host_start = s;
    if (at) {
        size_t ui_len = at - s;
        if (ui_len >= sizeof(p->userinfo)) ui_len = sizeof(p->userinfo) - 1;
        memcpy(p->userinfo, s, ui_len);
        p->userinfo[ui_len] = 0;
        host_start = at + 1;
    }

    // host:port
    const char* colon = strrchr(host_start, ':');
    if (colon) {
        size_t hlen = colon - host_start;
        if (hlen >= sizeof(p->host)) hlen = sizeof(p->host) - 1;
        memcpy(p->host, host_start, hlen);
        p->host[hlen] = 0;
        strncpy(p->port, colon + 1, sizeof(p->port) - 1);
    } else {
        strncpy(p->host, host_start, sizeof(p->host) - 1);
        strcpy(p->port, "8080");
    }
    p->valid = p->host[0] != 0;
}

// Simple Base64 encoder for proxy auth
static const char b64_table[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

static size_t base64_encode(const unsigned char* src, size_t len,
                            char* dst, size_t dst_sz) {
    size_t i = 0, j = 0;
    while (i < len && j + 4 < dst_sz) {
        uint32_t a = src[i++];
        uint32_t b = (i < len) ? src[i++] : 0;
        uint32_t c = (i < len) ? src[i++] : 0;
        uint32_t triple = (a << 16) | (b << 8) | c;
        dst[j++] = b64_table[(triple >> 18) & 0x3F];
        dst[j++] = b64_table[(triple >> 12) & 0x3F];
        dst[j++] = (i > len + 1) ? '=' : b64_table[(triple >> 6) & 0x3F];
        dst[j++] = (i > len) ? '=' : b64_table[triple & 0x3F];
    }
    dst[j] = 0;
    return j;
}

static int tls_conn_connect(TLSConn* c, const ParsedURL* url) {
    c->is_https = url->is_https;

    ProxyInfo proxy;
    parse_proxy_env(&proxy);

    if (proxy.valid && url->is_https) {
        // Connect via HTTP CONNECT proxy
        int ret = mbedtls_net_connect(&c->net, proxy.host, proxy.port,
                                       MBEDTLS_NET_PROTO_TCP);
        if (ret != 0) return ret;

        // Build CONNECT request
        char connect_req[8192];
        int n;
        if (proxy.userinfo[0]) {
            char b64[6144];
            base64_encode((const unsigned char*)proxy.userinfo,
                         strlen(proxy.userinfo), b64, sizeof(b64));
            n = snprintf(connect_req, sizeof(connect_req),
                "CONNECT %s:%s HTTP/1.1\r\n"
                "Host: %s:%s\r\n"
                "Proxy-Authorization: Basic %s\r\n"
                "\r\n", url->host, url->port, url->host, url->port, b64);
        } else {
            n = snprintf(connect_req, sizeof(connect_req),
                "CONNECT %s:%s HTTP/1.1\r\n"
                "Host: %s:%s\r\n"
                "\r\n", url->host, url->port, url->host, url->port);
        }
        // Send CONNECT via raw TCP
        ret = mbedtls_net_send(&c->net,
                               (const unsigned char*)connect_req, n);
        if (ret < 0) return ret;

        // Read proxy response
        char resp[4096];
        size_t resp_len = 0;
        while (resp_len < sizeof(resp) - 1) {
            ret = mbedtls_net_recv(&c->net,
                                   (unsigned char*)&resp[resp_len], 1);
            if (ret <= 0) break;
            resp_len++;
            // Check for end of headers
            if (resp_len >= 4 &&
                resp[resp_len-4] == '\r' && resp[resp_len-3] == '\n' &&
                resp[resp_len-2] == '\r' && resp[resp_len-1] == '\n')
                break;
        }
        resp[resp_len] = 0;

        // Check for 200
        if (!strstr(resp, "200")) {
            fprintf(stderr, "Error: Proxy CONNECT failed: %s\n", resp);
            return -1;
        }

        // Now do TLS handshake over the tunnel
        mbedtls_ssl_set_hostname(&c->ssl, url->host);
        mbedtls_ssl_set_bio(&c->ssl, &c->net, mbedtls_net_send,
                            mbedtls_net_recv, NULL);

        while ((ret = mbedtls_ssl_handshake(&c->ssl)) != 0) {
            if (ret != MBEDTLS_ERR_SSL_WANT_READ &&
                ret != MBEDTLS_ERR_SSL_WANT_WRITE) {
                return ret;
            }
        }
        return 0;
    }

    // Direct connection (no proxy)
    int ret = mbedtls_net_connect(&c->net, url->host, url->port,
                                   MBEDTLS_NET_PROTO_TCP);
    if (ret != 0) return ret;

    if (url->is_https) {
        mbedtls_ssl_set_hostname(&c->ssl, url->host);
        mbedtls_ssl_set_bio(&c->ssl, &c->net, mbedtls_net_send,
                            mbedtls_net_recv, NULL);
        ret = mbedtls_ssl_handshake(&c->ssl);
        if (ret != 0) return ret;
    }
    return 0;
}

static int tls_write(TLSConn* c, const unsigned char* data, size_t len) {
    size_t written = 0;
    while (written < len) {
        int ret;
        if (c->is_https)
            ret = mbedtls_ssl_write(&c->ssl, data + written, len - written);
        else
            ret = mbedtls_net_send(&c->net, data + written, len - written);
        if (ret < 0) return ret;
        written += ret;
    }
    return 0;
}

static int tls_read(TLSConn* c, unsigned char* buf, size_t len) {
    if (c->is_https)
        return mbedtls_ssl_read(&c->ssl, buf, len);
    else
        return mbedtls_net_recv(&c->net, buf, len);
}

// Read one line from the connection (up to \n)
static int tls_read_line(TLSConn* c, char* buf, size_t max) {
    size_t i = 0;
    while (i < max - 1) {
        int ret = tls_read(c, (unsigned char*)&buf[i], 1);
        if (ret <= 0) break;
        if (buf[i] == '\n') { i++; break; }
        i++;
    }
    buf[i] = 0;
    return (int)i;
}

// HTTP response header info
typedef struct {
    int status_code;
    size_t content_length;  // (size_t)-1 if not present
    char location[MAX_URL];
    int chunked;
} HTTPResponseInfo;

static void parse_http_headers(TLSConn* c, HTTPResponseInfo* info) {
    memset(info, 0, sizeof(*info));
    info->content_length = (size_t)-1;

    char line[4096];
    // Status line: "HTTP/1.1 200 OK\r\n"
    tls_read_line(c, line, sizeof(line));
    char* sp = strchr(line, ' ');
    if (sp) info->status_code = atoi(sp + 1);

    // Headers
    while (tls_read_line(c, line, sizeof(line)) > 0) {
        if (line[0] == '\r' || line[0] == '\n') break;
        // Strip trailing \r\n
        char* cr = strchr(line, '\r');
        if (cr) *cr = 0;
        char* nl = strchr(line, '\n');
        if (nl) *nl = 0;

        if (strncasecmp(line, "Content-Length:", 15) == 0) {
            info->content_length = (size_t)atoll(line + 15);
        } else if (strncasecmp(line, "Location:", 9) == 0) {
            const char* loc = line + 9;
            while (*loc == ' ') loc++;
            strncpy(info->location, loc, sizeof(info->location) - 1);
        } else if (strncasecmp(line, "Transfer-Encoding:", 18) == 0) {
            if (strstr(line + 18, "chunked")) info->chunked = 1;
        }
    }
}

// Read the full HTTP body into a malloc'd buffer
static char* read_http_body(TLSConn* c, HTTPResponseInfo* info, size_t* out_len) {
    char* buf = NULL;
    size_t total = 0, cap = 0;

    if (info->chunked) {
        char line[64];
        while (1) {
            tls_read_line(c, line, sizeof(line));
            size_t chunk_size = (size_t)strtoul(line, NULL, 16);
            if (chunk_size == 0) break;

            if (total + chunk_size + 1 >= cap) {
                cap = (total + chunk_size) * 2 + 1;
                buf = (char*)realloc(buf, cap);
            }

            size_t chunk_read = 0;
            while (chunk_read < chunk_size) {
                int ret = tls_read(c, (unsigned char*)(buf + total),
                                   chunk_size - chunk_read);
                if (ret <= 0) goto done;
                total += ret;
                chunk_read += ret;
            }
            // Read trailing \r\n
            tls_read_line(c, line, sizeof(line));
        }
    } else if (info->content_length != (size_t)-1) {
        cap = info->content_length + 1;
        buf = (char*)malloc(cap);
        while (total < info->content_length) {
            int ret = tls_read(c, (unsigned char*)(buf + total),
                               info->content_length - total);
            if (ret <= 0) break;
            total += ret;
        }
    } else {
        // Read until connection close
        cap = 65536;
        buf = (char*)malloc(cap);
        while (1) {
            if (total + 8192 >= cap) {
                cap *= 2;
                buf = (char*)realloc(buf, cap);
            }
            int ret = tls_read(c, (unsigned char*)(buf + total), 8192);
            if (ret <= 0) break;
            total += ret;
        }
    }

done:
    if (buf) buf[total] = 0;
    if (out_len) *out_len = total;
    return buf;
}

// Send an HTTP GET request
static int send_http_get(TLSConn* c, const ParsedURL* url) {
    char request[MAX_URL + 512];
    snprintf(request, sizeof(request),
        "GET %s HTTP/1.1\r\n"
        "Host: %s\r\n"
        "Connection: close\r\n"
        "User-Agent: runtimedl/1.0\r\n"
        "Accept: */*\r\n"
        "\r\n", url->path, url->host);
    return tls_write(c, (const unsigned char*)request, strlen(request));
}

// ============================================================================
// High-level HTTP functions (with redirect support)
// ============================================================================

// Fetch URL contents to a malloc'd string. Follows up to 10 redirects.
static char* fetch_url(const char* url, size_t* out_len) {
    char current_url[MAX_URL];
    strncpy(current_url, url, sizeof(current_url) - 1);
    current_url[sizeof(current_url) - 1] = 0;

    for (int redir = 0; redir < 10; redir++) {
        ParsedURL parsed;
        if (parse_url(current_url, &parsed) != 0) {
            fprintf(stderr, "Error: Invalid URL: %s\n", current_url);
            return NULL;
        }

        TLSConn conn;
        if (tls_conn_init(&conn) != 0) {
            fprintf(stderr, "Error: TLS init failed\n");
            return NULL;
        }

        if (tls_conn_connect(&conn, &parsed) != 0) {
            fprintf(stderr, "Error: Connection failed to %s:%s\n",
                    parsed.host, parsed.port);
            tls_conn_free(&conn);
            return NULL;
        }

        if (send_http_get(&conn, &parsed) != 0) {
            tls_conn_free(&conn);
            return NULL;
        }

        HTTPResponseInfo info;
        parse_http_headers(&conn, &info);

        if (info.status_code >= 300 && info.status_code < 400 &&
            info.location[0]) {
            // Redirect
            if (info.location[0] == '/') {
                snprintf(current_url, sizeof(current_url), "%s://%s%s",
                    parsed.is_https ? "https" : "http",
                    parsed.host, info.location);
            } else {
                strncpy(current_url, info.location, sizeof(current_url) - 1);
                current_url[sizeof(current_url) - 1] = 0;
            }
            tls_conn_free(&conn);
            continue;
        }

        if (info.status_code != 200) {
            fprintf(stderr, "Error: HTTP %d for %s\n",
                    info.status_code, current_url);
            tls_conn_free(&conn);
            return NULL;
        }

        char* body = read_http_body(&conn, &info, out_len);
        tls_conn_free(&conn);
        return body;
    }

    fprintf(stderr, "Error: Too many redirects\n");
    return NULL;
}

// Download URL to a file on disk with progress bar. Follows redirects.
static int download_file(const char* url, const char* dest) {
    char current_url[MAX_URL];
    strncpy(current_url, url, sizeof(current_url) - 1);
    current_url[sizeof(current_url) - 1] = 0;

    printf("Downloading to %s\n", dest);

    for (int redir = 0; redir < 10; redir++) {
        ParsedURL parsed;
        if (parse_url(current_url, &parsed) != 0) {
            fprintf(stderr, "Error: Invalid URL: %s\n", current_url);
            return -1;
        }

        TLSConn conn;
        if (tls_conn_init(&conn) != 0) return -1;
        if (tls_conn_connect(&conn, &parsed) != 0) {
            tls_conn_free(&conn);
            return -1;
        }
        if (send_http_get(&conn, &parsed) != 0) {
            tls_conn_free(&conn);
            return -1;
        }

        HTTPResponseInfo info;
        parse_http_headers(&conn, &info);

        if (info.status_code >= 300 && info.status_code < 400 &&
            info.location[0]) {
            if (info.location[0] == '/') {
                snprintf(current_url, sizeof(current_url), "%s://%s%s",
                    parsed.is_https ? "https" : "http",
                    parsed.host, info.location);
            } else {
                strncpy(current_url, info.location, sizeof(current_url) - 1);
                current_url[sizeof(current_url) - 1] = 0;
            }
            tls_conn_free(&conn);
            continue;
        }

        if (info.status_code != 200) {
            fprintf(stderr, "Error: HTTP %d\n", info.status_code);
            tls_conn_free(&conn);
            return -1;
        }

        FILE* out = fopen(dest, "wb");
        if (!out) {
            fprintf(stderr, "Error: Cannot create %s: %s\n",
                    dest, strerror(errno));
            tls_conn_free(&conn);
            return -1;
        }

        size_t total = 0;
        unsigned char buf[16384];
        while (1) {
            int ret = tls_read(&conn, buf, sizeof(buf));
            if (ret <= 0) break;
            fwrite(buf, 1, ret, out);
            total += ret;

            // Progress bar
            if (info.content_length != (size_t)-1 && info.content_length > 0) {
                int pct = (int)(total * 100 / info.content_length);
                int bar = pct / 2;
                printf("\r  [");
                for (int i = 0; i < 50; i++)
                    putchar(i < bar ? '=' : (i == bar ? '>' : ' '));
                printf("] %d%%", pct);
                fflush(stdout);
            } else {
                printf("\r  %zu bytes", total);
                fflush(stdout);
            }
        }
        printf("\n");

        fclose(out);
        tls_conn_free(&conn);
        return 0;
    }

    fprintf(stderr, "Error: Too many redirects\n");
    return -1;
}

// ============================================================================
// SHA-512 via mbedTLS
// ============================================================================

static void compute_file_sha512(const char* path, char out_hex[129]) {
    FILE *f = fopen(path, "rb");
    if (!f) { out_hex[0] = 0; return; }

    mbedtls_sha512_context ctx;
    mbedtls_sha512_init(&ctx);
    mbedtls_sha512_starts(&ctx, 0); // 0 = SHA-512

    unsigned char buf[8192];
    size_t n;
    while ((n = fread(buf, 1, sizeof(buf), f)) > 0)
        mbedtls_sha512_update(&ctx, buf, n);
    fclose(f);

    unsigned char hash[64];
    mbedtls_sha512_finish(&ctx, hash);
    mbedtls_sha512_free(&ctx);

    for (int i = 0; i < 64; i++)
        sprintf(out_hex + i*2, "%02x", hash[i]);
    out_hex[128] = 0;
}

// ============================================================================
// tar.gz extraction
// ============================================================================

static int mkdirp(const char* path) {
    char tmp[MAX_PATH_LEN];
    snprintf(tmp, sizeof(tmp), "%s", path);
    for (char *p = tmp + 1; *p; p++) {
        if (*p == '/') {
            *p = 0;
            mkdir(tmp, 0755);
            *p = '/';
        }
    }
    return mkdir(tmp, 0755);
}

static size_t parse_octal(const char *s, int n) {
    size_t val = 0;
    for (int i = 0; i < n && s[i] >= '0' && s[i] <= '7'; i++)
        val = val * 8 + (s[i] - '0');
    return val;
}

static int extract_tar_gz(const char* archive, const char* dest) {
    gzFile gz = gzopen(archive, "rb");
    if (!gz) { fprintf(stderr, "Error: cannot open %s\n", archive); return -1; }

    unsigned char header[512];
    while (gzread(gz, header, 512) == 512) {
        int all_zero = 1;
        for (int i = 0; i < 512; i++) { if (header[i]) { all_zero = 0; break; } }
        if (all_zero) break;

        char name[256] = {0};
        memcpy(name, header, 100);
        char typeflag = header[156];
        char prefix[156] = {0};
        memcpy(prefix, header + 345, 155);

        char fullpath[MAX_PATH_LEN];
        if (prefix[0])
            snprintf(fullpath, sizeof(fullpath), "%s/%s/%s", dest, prefix, name);
        else
            snprintf(fullpath, sizeof(fullpath), "%s/%s", dest, name);

        size_t size = parse_octal((char*)header + 124, 12);

        if (typeflag == '5' || (typeflag == 0 && name[strlen(name)-1] == '/')) {
            mkdirp(fullpath);
        } else if (typeflag == '0' || typeflag == 0 || typeflag == '7') {
            char parent[MAX_PATH_LEN];
            snprintf(parent, sizeof(parent), "%s", fullpath);
            char *last_slash = strrchr(parent, '/');
            if (last_slash) { *last_slash = 0; mkdirp(parent); }

            FILE *out = fopen(fullpath, "wb");
            if (!out) {
                fprintf(stderr, "Error: cannot create %s: %s\n",
                        fullpath, strerror(errno));
                size_t blocks = (size + 511) / 512;
                for (size_t b = 0; b < blocks; b++) {
                    unsigned char skip[512];
                    gzread(gz, skip, 512);
                }
                continue;
            }
            size_t remaining = size;
            while (remaining > 0) {
                unsigned char block[512];
                int r = gzread(gz, block, 512);
                if (r <= 0) break;
                size_t to_write = remaining < 512 ? remaining : 512;
                fwrite(block, 1, to_write, out);
                remaining -= to_write;
            }
            fclose(out);
            if (strstr(fullpath, "/dotnet") || strstr(fullpath, ".sh"))
                chmod(fullpath, 0755);
            else
                chmod(fullpath, 0644);
        } else {
            size_t blocks = (size + 511) / 512;
            for (size_t b = 0; b < blocks; b++) {
                unsigned char skip[512];
                gzread(gz, skip, 512);
            }
        }
    }
    gzclose(gz);
    return 0;
}

// ============================================================================
// Zip extraction via zlib inflate
// ============================================================================

static uint16_t read_u16_le(const unsigned char* p) {
    return (uint16_t)(p[0] | (p[1] << 8));
}

static uint32_t read_u32_le(const unsigned char* p) {
    return (uint32_t)(p[0] | (p[1] << 8) | (p[2] << 16) |
                      ((uint32_t)p[3] << 24));
}

#define ZIP_LOCAL_HEADER_SIG 0x04034b50

static int extract_zip(const char* archive, const char* dest) {
    FILE* f = fopen(archive, "rb");
    if (!f) {
        fprintf(stderr, "Error: cannot open %s\n", archive);
        return -1;
    }

    unsigned char hdr[30];
    while (fread(hdr, 1, 30, f) == 30) {
        uint32_t sig = read_u32_le(hdr);
        if (sig != ZIP_LOCAL_HEADER_SIG) break;

        uint16_t method = read_u16_le(hdr + 8);
        uint32_t comp_size = read_u32_le(hdr + 18);
        uint32_t uncomp_size = read_u32_le(hdr + 22);
        uint16_t name_len = read_u16_le(hdr + 26);
        uint16_t extra_len = read_u16_le(hdr + 28);

        char name[MAX_PATH_LEN] = {0};
        size_t to_read = name_len < (int)sizeof(name) - 1 ? name_len : sizeof(name) - 1;
        fread(name, 1, to_read, f);
        if (name_len > to_read) fseek(f, name_len - to_read, SEEK_CUR);

        // Skip extra field
        if (extra_len > 0) fseek(f, extra_len, SEEK_CUR);

        char fullpath[MAX_PATH_LEN];
        snprintf(fullpath, sizeof(fullpath), "%s/%s", dest, name);

        // Directory entry
        if (name_len > 0 && name[name_len - 1] == '/') {
            mkdirp(fullpath);
            // Still need to skip comp_size bytes if any
            if (comp_size > 0) fseek(f, comp_size, SEEK_CUR);
            continue;
        }

        // Ensure parent directory exists
        char parent[MAX_PATH_LEN];
        strncpy(parent, fullpath, sizeof(parent) - 1);
        parent[sizeof(parent) - 1] = 0;
        char* last_slash = strrchr(parent, '/');
        if (last_slash) { *last_slash = 0; mkdirp(parent); }

        // Read compressed data
        unsigned char* comp_data = (unsigned char*)malloc(comp_size + 1);
        if (!comp_data) { fclose(f); return -1; }
        if (comp_size > 0) fread(comp_data, 1, comp_size, f);

        FILE* out = fopen(fullpath, "wb");
        if (!out) {
            free(comp_data);
            continue;
        }

        if (method == 0) {
            // Stored (no compression)
            fwrite(comp_data, 1, comp_size, out);
        } else if (method == 8) {
            // Deflate
            unsigned char* uncomp_data = (unsigned char*)malloc(uncomp_size + 1);
            if (!uncomp_data) {
                free(comp_data);
                fclose(out);
                continue;
            }

            z_stream strm;
            memset(&strm, 0, sizeof(strm));
            strm.next_in = comp_data;
            strm.avail_in = comp_size;
            strm.next_out = uncomp_data;
            strm.avail_out = uncomp_size;

            if (inflateInit2(&strm, -MAX_WBITS) == Z_OK) {
                inflate(&strm, Z_FINISH);
                inflateEnd(&strm);
                fwrite(uncomp_data, 1, strm.total_out, out);
            } else {
                fprintf(stderr, "Warning: inflate failed for %s\n", name);
            }
            free(uncomp_data);
        } else {
            fprintf(stderr, "Warning: unsupported compression method %d for %s\n",
                    method, name);
        }

        free(comp_data);
        fclose(out);

        if (strstr(fullpath, "/dotnet") || strstr(fullpath, ".sh"))
            chmod(fullpath, 0755);
        else
            chmod(fullpath, 0644);
    }

    fclose(f);
    return 0;
}

// ============================================================================
// Semantic version parsing and comparison
// ============================================================================

typedef struct {
    int major, minor, patch;
    char prerelease[128];
} SemVer;

static int parse_semver(const char *s, SemVer *v) {
    v->major = v->minor = v->patch = 0;
    v->prerelease[0] = 0;
    if (!s) return -1;
    int n = sscanf(s, "%d.%d.%d", &v->major, &v->minor, &v->patch);
    if (n < 2) return -1;
    const char *dash = strchr(s, '-');
    if (dash) {
        strncpy(v->prerelease, dash + 1, sizeof(v->prerelease) - 1);
        v->prerelease[sizeof(v->prerelease)-1] = 0;
    }
    return 0;
}

static int semver_cmp(const SemVer *a, const SemVer *b) {
    if (a->major != b->major) return a->major - b->major;
    if (a->minor != b->minor) return a->minor - b->minor;
    if (a->patch != b->patch) return a->patch - b->patch;
    int a_pre = a->prerelease[0] != 0;
    int b_pre = b->prerelease[0] != 0;
    if (a_pre != b_pre) return b_pre - a_pre;
    if (a_pre && b_pre) return strcmp(a->prerelease, b->prerelease);
    return 0;
}

static int semver_satisfies(const SemVer *ver, const char *range, int include_pre) {
    if (!include_pre && ver->prerelease[0]) return 0;

    const char *p = range;
    while (*p == ' ') p++;

    char op[3] = {0};
    if (p[0] == '>' && p[1] == '=') { op[0] = '>'; op[1] = '='; p += 2; }
    else if (p[0] == '<' && p[1] == '=') { op[0] = '<'; op[1] = '='; p += 2; }
    else if (p[0] == '>') { op[0] = '>'; p++; }
    else if (p[0] == '<') { op[0] = '<'; p++; }
    else if (p[0] == '=') { op[0] = '='; p++; }
    else if (p[0] == '^') { op[0] = '^'; p++; }
    else if (p[0] == '~') { op[0] = '~'; p++; }
    else { op[0] = '='; }

    while (*p == ' ') p++;
    SemVer rv;
    if (parse_semver(p, &rv) != 0) return 0;

    int c = semver_cmp(ver, &rv);
    if (op[0] == '>' && op[1] == '=') return c >= 0;
    if (op[0] == '>') return c > 0;
    if (op[0] == '<' && op[1] == '=') return c <= 0;
    if (op[0] == '<') return c < 0;
    if (op[0] == '=') return c == 0;
    if (op[0] == '^') return c >= 0 && ver->major == rv.major;
    if (op[0] == '~') return c >= 0 && ver->major == rv.major && ver->minor == rv.minor;
    return 0;
}

// ============================================================================
// Platform/architecture detection and RID mapping
// ============================================================================

typedef struct {
    char platform[32];
    char arch[32];
} DetectedSystem;

static DetectedSystem detect_system(void) {
    DetectedSystem sys = {{0}, {0}};
    struct utsname un;
    if (uname(&un) == 0) {
        if (strstr(un.sysname, "Linux")) strcpy(sys.platform, "linux");
        else if (strstr(un.sysname, "Darwin")) strcpy(sys.platform, "macos");
        else if (strstr(un.sysname, "MINGW") || strstr(un.sysname, "CYGWIN") ||
                 strstr(un.sysname, "Windows") || strstr(un.sysname, "MSYS"))
            strcpy(sys.platform, "windows");
        else if (strstr(un.sysname, "FreeBSD")) strcpy(sys.platform, "linux");
        else strcpy(sys.platform, "linux");

        if (strstr(un.machine, "x86_64") || strstr(un.machine, "amd64"))
            strcpy(sys.arch, "x64");
        else if (strstr(un.machine, "aarch64") || strstr(un.machine, "arm64"))
            strcpy(sys.arch, "arm64");
        else if (strstr(un.machine, "armv7") || strstr(un.machine, "armhf"))
            strcpy(sys.arch, "arm32");
        else if (strstr(un.machine, "i686") || strstr(un.machine, "i386"))
            strcpy(sys.arch, "x86");
        else
            strcpy(sys.arch, "x64");
    } else {
        strcpy(sys.platform, "linux");
        strcpy(sys.arch, "x64");
    }
    return sys;
}

static const char* platform_to_rid(const char* platform) {
    if (strcmp(platform, "windows") == 0) return "win";
    if (strcmp(platform, "macos") == 0) return "osx";
    if (strcmp(platform, "linux") == 0) return "linux";
    return platform;
}

static const char* arch_to_rid(const char* arch) {
    if (strcmp(arch, "arm32") == 0) return "arm";
    return arch;
}

static void build_rid(const char* platform, const char* arch,
                      char* out, size_t out_sz) {
    const char *alpine = strstr(arch, "-alpine");
    if (alpine) {
        char base_arch[32];
        size_t base_len = alpine - arch;
        if (base_len >= sizeof(base_arch)) base_len = sizeof(base_arch) - 1;
        memcpy(base_arch, arch, base_len);
        base_arch[base_len] = 0;
        snprintf(out, out_sz, "linux-musl-%s", arch_to_rid(base_arch));
        return;
    }
    snprintf(out, out_sz, "%s-%s", platform_to_rid(platform), arch_to_rid(arch));
}

// ============================================================================
// Runtime DB: query Microsoft's releases index
// ============================================================================

typedef struct {
    char url[MAX_URL];
    char checksum[256];
    char version[64];
} RuntimeEntry;

static const char* type_to_json_key(const char* type) {
    if (strcmp(type, "sdk") == 0) return "sdk";
    if (strcmp(type, "runtime") == 0) return "runtime";
    if (strcmp(type, "runtime-aspnetcore") == 0) return "aspnetcore-runtime";
    if (strcmp(type, "runtime-desktop") == 0) return "windowsdesktop";
    return "runtime";
}

static const char* type_to_file_prefix(const char* type) {
    if (strcmp(type, "sdk") == 0) return "dotnet-sdk-";
    if (strcmp(type, "runtime") == 0) return "dotnet-runtime-";
    if (strcmp(type, "runtime-aspnetcore") == 0) return "aspnetcore-runtime-";
    if (strcmp(type, "runtime-desktop") == 0) return "windowsdesktop-runtime-";
    return "dotnet-runtime-";
}

static int find_best_entry(const char* runtime_type, const char* platform,
                           const char* arch, const char* version_pattern,
                           int include_prerelease, RuntimeEntry* result) {
    size_t len;
    char *index_json = fetch_url(RELEASES_INDEX_URL, &len);
    if (!index_json) {
        fprintf(stderr, "Error: Failed to fetch releases index\n");
        return -1;
    }

    cJSON *index = cJSON_Parse(index_json);
    free(index_json);
    if (!index) {
        fprintf(stderr, "Error: Failed to parse releases index JSON\n");
        return -1;
    }

    const char *json_key = type_to_json_key(runtime_type);
    const char *file_prefix = type_to_file_prefix(runtime_type);

    char rid[64];
    build_rid(platform, arch, rid, sizeof(rid));

    const char *ext = (strcmp(platform, "windows") == 0) ? ".zip" : ".tar.gz";

    SemVer best_ver = {0, 0, 0, {0}};
    int found = 0;

    cJSON *ri = cJSON_GetObjectItem(index, "releases-index");
    if (!ri) { cJSON_Delete(index); return -1; }

    cJSON *channel;
    cJSON_ArrayForEach(channel, ri) {
        cJSON *rel_url = cJSON_GetObjectItem(channel, "releases.json");
        if (!rel_url || !cJSON_IsString(rel_url)) continue;

        char *chan_json = fetch_url(rel_url->valuestring, &len);
        if (!chan_json) continue;

        cJSON *chan = cJSON_Parse(chan_json);
        free(chan_json);
        if (!chan) continue;

        cJSON *releases = cJSON_GetObjectItem(chan, "releases");
        if (!releases) { cJSON_Delete(chan); continue; }

        cJSON *release;
        cJSON_ArrayForEach(release, releases) {
            cJSON *component = cJSON_GetObjectItem(release, json_key);
            if (!component) continue;

            cJSON *ver_item = cJSON_GetObjectItem(component, "version");
            if (!ver_item || !cJSON_IsString(ver_item)) continue;

            SemVer ver;
            if (parse_semver(ver_item->valuestring, &ver) != 0) continue;
            if (!semver_satisfies(&ver, version_pattern, include_prerelease))
                continue;

            cJSON *files = cJSON_GetObjectItem(component, "files");
            if (!files) continue;

            cJSON *file;
            cJSON_ArrayForEach(file, files) {
                cJSON *file_rid = cJSON_GetObjectItem(file, "rid");
                if (!file_rid || !cJSON_IsString(file_rid)) continue;
                if (strcmp(file_rid->valuestring, rid) != 0) continue;

                cJSON *file_name = cJSON_GetObjectItem(file, "name");
                if (!file_name || !cJSON_IsString(file_name)) continue;
                if (strncmp(file_name->valuestring, file_prefix,
                            strlen(file_prefix)) != 0)
                    continue;

                const char *fname = file_name->valuestring;
                size_t fname_len = strlen(fname);
                size_t ext_len = strlen(ext);
                if (fname_len < ext_len) continue;
                if (strcmp(fname + fname_len - ext_len, ext) != 0) continue;

                if (!found || semver_cmp(&ver, &best_ver) > 0) {
                    cJSON *url_item = cJSON_GetObjectItem(file, "url");
                    cJSON *hash_item = cJSON_GetObjectItem(file, "hash");
                    if (url_item && cJSON_IsString(url_item)) {
                        strncpy(result->url, url_item->valuestring,
                                sizeof(result->url) - 1);
                        if (hash_item && cJSON_IsString(hash_item))
                            strncpy(result->checksum, hash_item->valuestring,
                                    sizeof(result->checksum) - 1);
                        else
                            result->checksum[0] = 0;
                        strncpy(result->version, ver_item->valuestring,
                                sizeof(result->version) - 1);
                        best_ver = ver;
                        found = 1;
                    }
                }
            }
        }
        cJSON_Delete(chan);
    }

    cJSON_Delete(index);
    return found ? 0 : -1;
}

// ============================================================================
// CLI and main logic
// ============================================================================

static void print_usage(const char* prog) {
    printf("runtimedl v%s - .NET Runtime Downloader (APE)\n\n", VERSION);
    printf("Usage: %s [options]\n\n", prog);
    printf("Options:\n");
    printf("  --runtime-type TYPE    Runtime type: sdk, runtime, runtime-aspnetcore,\n");
    printf("                         runtime-desktop (default: runtime)\n");
    printf("  --platform PLATFORM    Platform: linux, windows, macos, local\n");
    printf("                         (default: local = auto-detect)\n");
    printf("  --architecture ARCH    Architecture: x64, x86, arm64, arm32,\n");
    printf("                         arm64-alpine, local (default: local = auto-detect)\n");
    printf("  --version-pattern PAT  Semver range: >1.0.0, >=8.0.0, ^8.0.0, etc.\n");
    printf("                         (default: >0.0.0)\n");
    printf("  --include-prerelease   Include prerelease versions (default: false)\n");
    printf("  --output DIR           Output directory (default: ./runtime)\n");
    printf("  --download BOOL        Download the runtime (default: true)\n");
    printf("  --help                 Show this help message\n");
    printf("  --version              Show version information\n");
}

static void strtolower(char *s) {
    for (; *s; s++) if (*s >= 'A' && *s <= 'Z') *s += 32;
}

} // end raw block

fn main() {
    raw {
        char runtime_type[64] = "runtime";
        char platform[64] = "local";
        char architecture[64] = "local";
        char version_pattern[256] = ">0.0.0";
        int include_prerelease = 0;
        char output[MAX_PATH_LEN] = "./runtime";
        int do_download = 1;

        static struct option long_opts[] = {
            {"runtime-type", required_argument, 0, 't'},
            {"platform", required_argument, 0, 'p'},
            {"architecture", required_argument, 0, 'a'},
            {"version-pattern", required_argument, 0, 'v'},
            {"include-prerelease", no_argument, 0, 'r'},
            {"output", required_argument, 0, 'o'},
            {"download", required_argument, 0, 'd'},
            {"help", no_argument, 0, 'h'},
            {"version", no_argument, 0, 'V'},
            {0, 0, 0, 0}
        };

        extern int __argc;
        extern char **__argv;
        int argc = __argc;
        char **argv = __argv;

        int opt;
        optind = 1;
        while ((opt = getopt_long(argc, argv, "t:p:a:v:ro:d:hV",
                                  long_opts, NULL)) != -1) {
            switch (opt) {
                case 't': strncpy(runtime_type, optarg,
                                  sizeof(runtime_type)-1); break;
                case 'p': strncpy(platform, optarg,
                                  sizeof(platform)-1); break;
                case 'a': strncpy(architecture, optarg,
                                  sizeof(architecture)-1); break;
                case 'v': strncpy(version_pattern, optarg,
                                  sizeof(version_pattern)-1); break;
                case 'r': include_prerelease = 1; break;
                case 'o': strncpy(output, optarg,
                                  sizeof(output)-1); break;
                case 'd':
                    if (strcmp(optarg, "false") == 0 ||
                        strcmp(optarg, "0") == 0 ||
                        strcmp(optarg, "False") == 0)
                        do_download = 0;
                    break;
                case 'h': print_usage(argv[0]); exit(0);
                case 'V': printf("runtimedl v%s (APE)\n", VERSION); exit(0);
                default: print_usage(argv[0]); exit(1);
            }
        }

        strtolower(runtime_type);
        for (char *p = runtime_type; *p; p++) if (*p == '_') *p = '-';
        strtolower(platform);
        strtolower(architecture);

        if (strcmp(platform, "local") == 0 ||
            strcmp(architecture, "local") == 0) {
            DetectedSystem sys = detect_system();
            if (strcmp(platform, "local") == 0)
                strcpy(platform, sys.platform);
            if (strcmp(architecture, "local") == 0)
                strcpy(architecture, sys.arch);
        }

        printf("Runtime Type     : %s\n", runtime_type);
        printf("Platform         : %s\n", platform);
        printf("Architecture     : %s\n", architecture);
        printf("Version Pattern  : %s\n", version_pattern);
        printf("Output           : %s\n", output);
        printf("\n");

        printf("Querying releases...\n");
        RuntimeEntry entry = {{0}, {0}, {0}};
        if (find_best_entry(runtime_type, platform, architecture,
                            version_pattern, include_prerelease,
                            &entry) != 0) {
            fprintf(stderr,
                "Error: No matching entry found for type=%s, "
                "platform=%s, arch=%s, version=%s\n",
                runtime_type, platform, architecture, version_pattern);
            exit(1);
        }

        printf("Found Entry      :\n");
        printf("  Version        : %s\n", entry.version);
        printf("  URL            : %s\n", entry.url);
        printf("  Checksum       : %s\n", entry.checksum);
        printf("\n");

        if (!do_download) {
            exit(0);
        }

        const char *tmpdir = "/tmp/runtimedl";
        mkdir(tmpdir, 0755);

        const char *fname = strrchr(entry.url, '/');
        if (!fname) fname = "download"; else fname++;
        char tmpfile[MAX_PATH_LEN];
        snprintf(tmpfile, sizeof(tmpfile), "%s/%s", tmpdir, fname);

        if (download_file(entry.url, tmpfile) != 0) {
            fprintf(stderr, "Error: Download failed\n");
            exit(1);
        }
        printf("Download complete\n");

        if (entry.checksum[0]) {
            printf("Verifying checksum...\n");
            char computed[129];
            compute_file_sha512(tmpfile, computed);
            char expected_lower[256];
            strncpy(expected_lower, entry.checksum,
                    sizeof(expected_lower)-1);
            expected_lower[sizeof(expected_lower)-1] = 0;
            strtolower(expected_lower);
            strtolower(computed);
            if (strcmp(computed, expected_lower) != 0) {
                fprintf(stderr,
                    "Error: Checksum mismatch!\n"
                    "  Expected: %s\n  Got:      %s\n",
                    expected_lower, computed);
                remove(tmpfile);
                exit(1);
            }
            printf("Hash OK          : %s\n", computed);
        }

        printf("Unpacking...\n");
        char outdir[MAX_PATH_LEN];
        snprintf(outdir, sizeof(outdir), "%s/%s/%s",
                 output, platform, architecture);
        mkdirp(outdir);

        if (strstr(tmpfile, ".tar.gz")) {
            if (extract_tar_gz(tmpfile, outdir) != 0) {
                fprintf(stderr, "Error: Extraction failed\n");
                exit(1);
            }
        } else if (strstr(tmpfile, ".zip")) {
            if (extract_zip(tmpfile, outdir) != 0) {
                fprintf(stderr, "Error: Zip extraction failed\n");
                exit(1);
            }
        } else {
            fprintf(stderr, "Error: Unknown archive format: %s\n", tmpfile);
            exit(1);
        }

        printf("Cleaning up\n");
        remove(tmpfile);

        printf("Done\n");
    }
}
