// runtimedl - .NET Runtime Downloader
// A cross-OS Actually Portable Executable (APE) built with Zen-C + cosmocc
//
// Downloads and extracts .NET runtimes from Microsoft's official releases.
// Single binary runs on Linux, macOS, Windows, FreeBSD, OpenBSD, NetBSD.

import "./runtimedb.zc"
import "./archive.zc"

raw {
#include <getopt.h>

#define VERSION "1.0.0"

static void print_usage(const char* prog) {
    printf("runtimedl v%s - .NET Runtime Downloader (APE)\n\n", VERSION);
    printf("Usage: %s [options]\n\n", prog);
    printf("Options:\n");
    printf("  --runtime-type TYPE    Runtime type: sdk, runtime, runtime-aspnetcore,\n");
    printf("                         runtime-desktop (default: runtime)\n");
    printf("  --platform PLATFORM    Platform: linux, windows, macos, local\n");
    printf("                         (default: local = auto-detect)\n");
    printf("  --architecture ARCH    Architecture: x64, x86, arm64, arm32,\n");
    printf("                         arm64-alpine, local (default: local = auto-detect)\n");
    printf("  --version-pattern PAT  Semver range: >1.0.0, >=8.0.0, ^8.0.0, etc.\n");
    printf("                         (default: >0.0.0)\n");
    printf("  --include-prerelease   Include prerelease versions (default: false)\n");
    printf("  --output DIR           Output directory (default: ./runtime)\n");
    printf("  --download BOOL        Download the runtime (default: true)\n");
    printf("  --help                 Show this help message\n");
    printf("  --version              Show version information\n");
}

static void strtolower(char *s) {
    for (; *s; s++) if (*s >= 'A' && *s <= 'Z') *s += 32;
}
}

fn main() {
    raw {
        char runtime_type[64] = "runtime";
        char platform[64] = "local";
        char architecture[64] = "local";
        char version_pattern[256] = ">0.0.0";
        int include_prerelease = 0;
        char output[MAX_PATH_LEN] = "./runtime";
        int do_download = 1;

        static struct option long_opts[] = {
            {"runtime-type", required_argument, 0, 't'},
            {"platform", required_argument, 0, 'p'},
            {"architecture", required_argument, 0, 'a'},
            {"version-pattern", required_argument, 0, 'v'},
            {"include-prerelease", no_argument, 0, 'r'},
            {"output", required_argument, 0, 'o'},
            {"download", required_argument, 0, 'd'},
            {"help", no_argument, 0, 'h'},
            {"version", no_argument, 0, 'V'},
            {0, 0, 0, 0}
        };

        extern int __argc;
        extern char **__argv;
        int argc = __argc;
        char **argv = __argv;

        int opt;
        optind = 1;
        while ((opt = getopt_long(argc, argv, "t:p:a:v:ro:d:hV",
                                  long_opts, NULL)) != -1) {
            switch (opt) {
                case 't': strncpy(runtime_type, optarg,
                                  sizeof(runtime_type)-1); break;
                case 'p': strncpy(platform, optarg,
                                  sizeof(platform)-1); break;
                case 'a': strncpy(architecture, optarg,
                                  sizeof(architecture)-1); break;
                case 'v': strncpy(version_pattern, optarg,
                                  sizeof(version_pattern)-1); break;
                case 'r': include_prerelease = 1; break;
                case 'o': strncpy(output, optarg,
                                  sizeof(output)-1); break;
                case 'd':
                    if (strcmp(optarg, "false") == 0 ||
                        strcmp(optarg, "0") == 0 ||
                        strcmp(optarg, "False") == 0)
                        do_download = 0;
                    break;
                case 'h': print_usage(argv[0]); exit(0);
                case 'V': printf("runtimedl v%s (APE)\n", VERSION); exit(0);
                default: print_usage(argv[0]); exit(1);
            }
        }

        strtolower(runtime_type);
        for (char *p = runtime_type; *p; p++) if (*p == '_') *p = '-';
        strtolower(platform);
        strtolower(architecture);

        if (strcmp(platform, "local") == 0 ||
            strcmp(architecture, "local") == 0) {
            DetectedSystem sys = detect_system();
            if (strcmp(platform, "local") == 0)
                strcpy(platform, sys.platform);
            if (strcmp(architecture, "local") == 0)
                strcpy(architecture, sys.arch);
        }

        printf("Runtime Type     : %s\n", runtime_type);
        printf("Platform         : %s\n", platform);
        printf("Architecture     : %s\n", architecture);
        printf("Version Pattern  : %s\n", version_pattern);
        printf("Output           : %s\n", output);
        printf("\n");

        printf("Querying releases...\n");
        RuntimeEntry entry = {{0}, {0}, {0}};
        if (find_best_entry(runtime_type, platform, architecture,
                            version_pattern, include_prerelease,
                            &entry) != 0) {
            fprintf(stderr,
                "Error: No matching entry found for type=%s, "
                "platform=%s, arch=%s, version=%s\n",
                runtime_type, platform, architecture, version_pattern);
            exit(1);
        }

        printf("Found Entry      :\n");
        printf("  Version        : %s\n", entry.version);
        printf("  URL            : %s\n", entry.url);
        printf("  Checksum       : %s\n", entry.checksum);
        printf("\n");

        if (!do_download) {
            exit(0);
        }

        const char *tmpdir = "/tmp/runtimedl";
        mkdir(tmpdir, 0755);

        const char *fname = strrchr(entry.url, '/');
        if (!fname) fname = "download"; else fname++;
        char tmpfile[MAX_PATH_LEN];
        snprintf(tmpfile, sizeof(tmpfile), "%s/%s", tmpdir, fname);

        if (download_file(entry.url, tmpfile) != 0) {
            fprintf(stderr, "Error: Download failed\n");
            exit(1);
        }
        printf("Download complete\n");

        if (entry.checksum[0]) {
            printf("Verifying checksum...\n");
            char computed[129];
            compute_file_sha512(tmpfile, computed);
            char expected_lower[256];
            strncpy(expected_lower, entry.checksum,
                    sizeof(expected_lower)-1);
            expected_lower[sizeof(expected_lower)-1] = 0;
            strtolower(expected_lower);
            strtolower(computed);
            if (strcmp(computed, expected_lower) != 0) {
                fprintf(stderr,
                    "Error: Checksum mismatch!\n"
                    "  Expected: %s\n  Got:      %s\n",
                    expected_lower, computed);
                remove(tmpfile);
                exit(1);
            }
            printf("Hash OK          : %s\n", computed);
        }

        printf("Unpacking...\n");
        char outdir[MAX_PATH_LEN];
        snprintf(outdir, sizeof(outdir), "%s/%s/%s",
                 output, platform, architecture);
        mkdirp(outdir);

        if (strstr(tmpfile, ".tar.gz")) {
            if (extract_tar_gz(tmpfile, outdir) != 0) {
                fprintf(stderr, "Error: Extraction failed\n");
                exit(1);
            }
        } else if (strstr(tmpfile, ".zip")) {
            if (extract_zip(tmpfile, outdir) != 0) {
                fprintf(stderr, "Error: Zip extraction failed\n");
                exit(1);
            }
        } else {
            fprintf(stderr, "Error: Unknown archive format: %s\n", tmpfile);
            exit(1);
        }

        printf("Cleaning up\n");
        remove(tmpfile);

        printf("Done\n");
    }
}
