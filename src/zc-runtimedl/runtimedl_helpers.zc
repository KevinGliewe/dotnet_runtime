// runtimedl_helpers.zc — Extracted helper functions for runtimedl

import "./extern/zenc-std/io.zc"

raw {
// Forward declarations for Zen-C functions called from C
void strtolower(char *s);
void normalize_runtime_type(char *s);
int32_t is_false_str(char *s);
char* get_filename_from_url(char *url);
int32_t detect_archive_format(char *filename);
}

fn strtolower(_s: char*) {
    let i: usize = 0
    while (_s[i] != 0) {
        if (_s[i] >= 'A' && _s[i] <= 'Z') {
            _s[i] = _s[i] + 32
        }
        i = i + 1
    }
}

fn normalize_runtime_type(_s: char*) {
    strtolower(_s)
    let s = String::new(_s)
    let result = s.replace("_", "-")
    let _r = result.c_str()
    let i: usize = 0
    while (_r[i] != 0) {
        _s[i] = _r[i]
        i = i + 1
    }
    _s[i] = 0
}

fn is_false_str(s: char*) -> int {
    let str = String::new(s)
    if (str.eq_str("false") || str.eq_str("0") || str.eq_str("False")) {
        return 1
    }
    return 0
}

fn get_filename_from_url(url: char*) -> char* {
    raw { static char _fname_buf[2048]; }
    let s = String::new(url)
    // Find last slash
    let last: usize = 0
    let i: usize = 0
    let found = 0
    while (i < s.length()) {
        if (s.vec.get(i) == '/') {
            last = i
            found = 1
        }
        i = i + 1
    }
    if (found == 0 || last + 1 >= s.length()) {
        return "download"
    }
    let name = s.substring(last + 1, s.length() - last - 1)
    if (name.is_empty()) {
        return "download"
    }
    // Copy to static buffer to avoid use-after-free
    let _n = name.c_str()
    let j: usize = 0
    while (_n[j] != 0 && j < 2047) {
        _fname_buf[j] = _n[j]
        j = j + 1
    }
    _fname_buf[j] = 0
    return _fname_buf
}

fn detect_archive_format(filename: char*) -> int {
    let s = String::new(filename)
    if (s.ends_with(".tar.gz")) {
        return 1
    }
    if (s.ends_with(".zip")) {
        return 2
    }
    return 0
}

