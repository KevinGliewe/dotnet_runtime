// test_semver.zc — Unit tests for semver module using native Zen-C test blocks

import "./semver.zc"

test "parse basic version" {
    let v = parse_semver("8.0.25")
    assert(v.major == 8, "major should be 8")
    assert(v.minor == 0, "minor should be 0")
    assert(v.patch == 25, "patch should be 25")
    assert(v.prerelease.is_empty(), "prerelease should be empty")
}

test "parse prerelease version" {
    let v = parse_semver("9.0.0-preview.1")
    assert(v.major == 9, "major should be 9")
    assert(v.minor == 0, "minor should be 0")
    assert(v.patch == 0, "patch should be 0")
    assert(v.prerelease.eq_str("preview.1"), "prerelease should be preview.1")
}

test "parse two-part version" {
    let v = parse_semver("8.0")
    assert(v.major == 8, "major should be 8")
    assert(v.minor == 0, "minor should be 0")
    assert(v.patch == 0, "patch should be 0")
}

test "compare major difference" {
    let a = parse_semver("9.0.0")
    let b = parse_semver("8.99.99")
    assert(semver_cmp(&a, &b) > 0, "9.0.0 > 8.99.99")
}

test "compare patch difference" {
    let a = parse_semver("8.0.25")
    let b = parse_semver("8.0.24")
    assert(semver_cmp(&a, &b) > 0, "8.0.25 > 8.0.24")
}

test "compare equal versions" {
    let a = parse_semver("8.0.0")
    let b = parse_semver("8.0.0")
    assert(semver_cmp(&a, &b) == 0, "8.0.0 == 8.0.0")
}

test "compare release beats prerelease" {
    let a = parse_semver("9.0.0")
    let b = parse_semver("9.0.0-preview.1")
    assert(semver_cmp(&a, &b) > 0, "9.0.0 > 9.0.0-preview.1")
}

test "satisfies greater than" {
    let v = parse_semver("8.0.25")
    assert(semver_satisfies(&v, ">8.0.0", 0) == 1, "8.0.25 satisfies >8.0.0")
}

test "satisfies greater than or equal" {
    let v = parse_semver("8.0.25")
    assert(semver_satisfies(&v, ">=8.0.25", 0) == 1, "8.0.25 satisfies >=8.0.25")
}

test "satisfies caret range" {
    let v = parse_semver("8.0.25")
    assert(semver_satisfies(&v, "^8.0.0", 0) == 1, "8.0.25 satisfies ^8.0.0")
}

test "does not satisfy less than" {
    let v = parse_semver("8.0.25")
    assert(semver_satisfies(&v, "<8.0.0", 0) == 0, "8.0.25 does NOT satisfy <8.0.0")
}

test "does not satisfy tilde wrong major" {
    let v = parse_semver("8.0.25")
    assert(semver_satisfies(&v, "~9.0.0", 0) == 0, "8.0.25 does NOT satisfy ~9.0.0")
}

test "satisfies exact match" {
    let v = parse_semver("8.0.25")
    assert(semver_satisfies(&v, "=8.0.25", 0) == 1, "8.0.25 satisfies =8.0.25")
    assert(semver_satisfies(&v, "=8.0.24", 0) == 0, "8.0.25 does NOT satisfy =8.0.24")
}

test "prerelease excluded by default" {
    let v = parse_semver("9.0.0-rc.1")
    assert(semver_satisfies(&v, ">0.0.0", 0) == 0, "9.0.0-rc.1 excluded by default")
}

test "prerelease included with flag" {
    let v = parse_semver("9.0.0-rc.1")
    assert(semver_satisfies(&v, ">0.0.0", 1) == 1, "9.0.0-rc.1 included with flag")
    assert(semver_satisfies(&v, "^9.0.0-alpha.0", 1) == 1, "9.0.0-rc.1 satisfies ^9.0.0-alpha.0 with flag")
}

test "backward compat _sv_parse" {
    raw {
        SemVer v;
        assert(_sv_parse("8.0.25", &v) == 0, "_sv_parse should succeed");
        assert(v.major == 8, "_sv_parse major");
        assert(v.minor == 0, "_sv_parse minor");
        assert(v.patch == 25, "_sv_parse patch");
        assert(_sv_parse(NULL, &v) == -1, "_sv_parse NULL should fail");
        assert(_sv_parse("abc", &v) == -1, "_sv_parse abc should fail");
        assert(_sv_parse("1", &v) == -1, "_sv_parse 1 should fail");
    }
}
